{
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "docker": "sh ./prepare-docker.sh",
    "publish-frontend": "sh ./npm_publish.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --configuration ci",
    "test:components": "ng test components -c ci",
    "test-debug:components": "ng test components --watch true --browsers=Chrome",
    "test:atlas": "ng test atlas-frontend -c ci",
    "test-debug:atlas": "ng test atlas-frontend --watch true --browsers=Chrome",
    "lint": "ng lint",
    "format": "prettier --write src/**/*.ts",
    "build:ngssc": "ng run atlas-frontend:ngsscbuild:production",
    "build-prod": "ng run atlas-frontend:ngsscbuild:production",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:open-e2e-release": "cypress open --config specPattern=cypress/release",
    "cypress:run-e2e-release": "cypress run --config specPattern=cypress/release",
    "generate-api": "openapi-generator-cli generate -g typescript-angular -i ../apim-configuration/build/resources/main/local/spec.yaml -o src/app/api --type-mappings=date=Date --additional-properties apiModulePrefix=Atlas --global-property models,skipFormModel=false"
  },
  "name": "atlas-frontend",
  "repository": {
    "type": "git",
    "url": "git+https://code.sbb.ch/scm/ki_atlas/atlas.git"
  },
  "version": "2.1071.0",
  "files": [
    "dist/*"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "crlf"
  },
  "lint-staged": {
    "frontend/src/**/*": "frontend/node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
  },
  "engines": {
    "npm": "10.9.4"
  },
  "dependencies": {
    "@angular/animations": "21.1.2",
    "@angular/cdk": "21.1.2",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/material": "21.1.2",
    "@angular/material-moment-adapter": "21.1.2",
    "@angular/platform-browser": "21.1.2",
    "@angular/platform-browser-dynamic": "21.1.2",
    "@angular/router": "21.1.2",
    "@angular/service-worker": "21.1.2",
    "@ng-select/ng-select": "21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "angular-auth-oidc-client": "21.0.1",
    "angular-server-side-configuration": "^21.0.0",
    "bootstrap": "^5.3",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "5.17.0",
    "moment": "^2.30",
    "proj4": "^2.12.1",
    "rxjs": "^7.8",
    "tslib": "^2.8",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2101.0",
    "@angular-devkit/build-angular": "21.1.2",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/schematics": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/cli": "21.1.3",
    "@angular/localize": "21.1.2",
    "@cypress/schematic": "^5.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.13.0",
    "@openapitools/openapi-generator-cli": "~2.28.0",
    "@playwright/test": "^1.48.1",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^24.0.0",
    "@types/proj4": "^2.5.5",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "cypress": "^15.8.0",
    "cypress-failed-log": "^2.10",
    "cypress-high-resolution": "^1.0",
    "cypress-mochawesome-reporter": "^4.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.0.0",
    "jasmine-core": "^5.4",
    "karma": "^6.4.4",
    "karma-browserstack-launcher": "^1.6",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-sonarqube-reporter": "^1.4.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.7.3",
    "puppeteer": "^24.0.0",
    "typescript": "^5.8.2"
  },
  "workspaces": [
    "components/form"
  ]
}
