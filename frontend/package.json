{
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng run atlas-frontend:ngsscbuild:production",
    "docker": "sh ./prepare-docker.sh",
    "publish-frontend": "sh ./npm_publish.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:components": "ng test components",
    "test-debug:components": "ng test components --watch=true",
    "test:atlas-frontend": "ng test atlas-frontend",
    "test-debug:atlas-frontend": "ng test atlas-frontend --watch=true",
    "lint": "ng lint",
    "format": "prettier --write {src,cypress}/**/*.{ts,html}",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:open-e2e-release": "cypress open --config specPattern=cypress/release",
    "cypress:run-e2e-release": "cypress run --config specPattern=cypress/release",
    "generate-api": "openapi-generator-cli generate -g typescript-angular -i ../apim-configuration/build/resources/main/local/spec.yaml -o src/app/api --type-mappings=date=Date --additional-properties apiModulePrefix=Atlas --global-property models,skipFormModel=false"
  },
  "name": "atlas-frontend",
  "repository": {
    "type": "git",
    "url": "git+https://code.sbb.ch/scm/ki_atlas/atlas.git"
  },
  "version": "2.1374.0",
  "files": [
    "dist/*"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "printWidth": 120,
    "htmlWhitespaceSensitivity": "strict",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "frontend/src/**/*": "frontend/node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
  },
  "engines": {
    "npm": "11.12.1"
  },
  "dependencies": {
    "@angular/animations": "22.0.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "22.0.0",
    "@angular/material-moment-adapter": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@angular/router": "22.0.0",
    "@angular/service-worker": "22.0.0",
    "@ng-select/ng-select": "23.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "angular-auth-oidc-client": "21.0.2",
    "angular-server-side-configuration": "^22.0.0",
    "bootstrap": "^5.3",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "5.24.0",
    "moment": "^2.30",
    "proj4": "^2.20.9",
    "geotiff": "^2.1.3",
    "rxjs": "^7.8",
    "tslib": "^2.8",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@angular/localize": "22.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.0.0",
    "@cypress/schematic": "^5.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@openapitools/openapi-generator-cli": "~2.35.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "typescript-eslint": "8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "cypress": "^15.17.0",
    "cypress-failed-log": "^2.10",
    "cypress-high-resolution": "^1.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "jiti": "2.7.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.8",
    "vitest-mock-extended": "^4.0.0"
  }
}
