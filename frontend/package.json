{
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng run atlas-frontend:ngsscbuild:production",
    "docker": "sh ./prepare-docker.sh",
    "publish-frontend": "sh ./npm_publish.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:form": "ng test form",
    "test-debug:form": "ng test form --watch=true",
    "test:atlas-frontend": "ng test atlas-frontend",
    "test-debug:atlas-frontend": "ng test atlas-frontend --watch=true",
    "lint": "ng lint",
    "format": "prettier --write {src,cypress}/**/*.{ts,html}",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chromium",
    "cypress:open-e2e-release": "cypress open --config specPattern=cypress/release/**/*.cy.ts",
    "cypress:run-e2e-release": "cypress run --browser chromium --config specPattern=cypress/release/**/*.cy.ts",
    "generate-api": "openapi-generator-cli generate -g typescript-angular -i ../apim-configuration/build/resources/main/local/spec.yaml -o src/app/api --type-mappings=date=Date --additional-properties apiModulePrefix=Atlas --global-property models,skipFormModel=false"
  },
  "name": "atlas-frontend",
  "repository": {
    "type": "git",
    "url": "git+https://code.sbb.ch/scm/ki_atlas/atlas.git"
  },
  "version": "2.1554.0",
  "files": [
    "dist/*"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "printWidth": 120,
    "htmlWhitespaceSensitivity": "strict",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "frontend/src/**/*": "frontend/node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
  },
  "engines": {
    "npm": "11.16.0"
  },
  "dependencies": {
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/material": "22.1.5",
    "@angular/material-moment-adapter": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/service-worker": "22.1.5",
    "@ng-select/ng-select": "24.1.1",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "angular-auth-oidc-client": "22.0.0",
    "angular-server-side-configuration": "22.0.2",
    "bootstrap": "5.3",
    "geotiff": "3.0.5",
    "jwt-decode": "4.0.0",
    "maplibre-gl": "6.7.0",
    "moment": "2.30",
    "proj4": "2.22.0",
    "rxjs": "7.8",
    "tslib": "2.8",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@angular/localize": "22.1.5",
    "@cypress/schematic": "6.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.3.0",
    "cypress": "16.0.0",
    "cypress-failed-log": "2.10",
    "cypress-mochawesome-reporter": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.0",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "vitest-mock-extended": "5.1.1"
  }
}
