{
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng run atlas-frontend:ngsscbuild:production",
    "docker": "sh ./prepare-docker.sh",
    "publish-frontend": "sh ./npm_publish.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:components": "ng test components",
    "test-debug:components": "ng test components --watch=true",
    "test:atlas-frontend": "ng test atlas-frontend",
    "test-debug:atlas-frontend": "ng test atlas-frontend --watch=true",
    "lint": "ng lint",
    "format": "prettier --write src/**/*.ts",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:open-e2e-release": "cypress open --config specPattern=cypress/release",
    "cypress:run-e2e-release": "cypress run --config specPattern=cypress/release",
    "generate-api": "openapi-generator-cli generate -g typescript-angular -i ../apim-configuration/build/resources/main/local/spec.yaml -o src/app/api --type-mappings=date=Date --additional-properties apiModulePrefix=Atlas --global-property models,skipFormModel=false"
  },
  "name": "atlas-frontend",
  "repository": {
    "type": "git",
    "url": "git+https://code.sbb.ch/scm/ki_atlas/atlas.git"
  },
  "version": "2.1189.0",
  "files": [
    "dist/*"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "crlf"
  },
  "lint-staged": {
    "frontend/src/**/*": "frontend/node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
  },
  "engines": {
    "npm": "11.6.2"
  },
  "dependencies": {
    "@angular/animations": "21.2.6",
    "@angular/cdk": "21.2.4",
    "@angular/common": "21.2.6",
    "@angular/compiler": "21.2.6",
    "@angular/core": "21.2.6",
    "@angular/forms": "21.2.6",
    "@angular/material": "21.2.4",
    "@angular/material-moment-adapter": "21.2.4",
    "@angular/platform-browser": "21.2.6",
    "@angular/platform-browser-dynamic": "21.2.6",
    "@angular/router": "21.2.6",
    "@angular/service-worker": "21.2.6",
    "@ng-select/ng-select": "21.5.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "angular-auth-oidc-client": "21.0.1",
    "angular-server-side-configuration": "^21.0.0",
    "bootstrap": "^5.3",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "5.21.1",
    "moment": "^2.30",
    "proj4": "^2.12.1",
    "rxjs": "^7.8",
    "tslib": "^2.8",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/schematics": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/build": "21.2.4",
    "@angular/cli": "21.2.4",
    "@angular/compiler-cli": "21.2.6",
    "@angular/localize": "21.2.6",
    "@cypress/schematic": "^5.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.13.0",
    "@openapitools/openapi-generator-cli": "~2.31.0",
    "@playwright/test": "^1.48.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.8",
    "cypress": "^15.8.0",
    "cypress-failed-log": "^2.10",
    "cypress-high-resolution": "^1.0",
    "cypress-mochawesome-reporter": "^4.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.0.0",
    "ng-packagr": "^21.1.0",
    "prettier": "^3.7.3",
    "puppeteer": "^24.0.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.8",
    "vitest-mock-extended": "^3.1.0"
  }
}
